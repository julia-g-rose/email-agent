# Judge (RULER + correctness) runs on an OpenAI-compatible model.
OPENAI_API_KEY=

# W&B — inference, Serverless Training, and logging.
WANDB_API_KEY=

# Optional overrides
# WANDB_PROJECT=email-search-agent
# BASELINE_MODEL=gpt-4o            # closed model for the baseline agent
# BASE_MODEL=Qwen/Qwen3.6-27B      # open-source base to fine-tune
# JUDGE_MODEL=openai/gpt-4o-mini   # per-answer correctness judge
# RULER_MODEL=openai/gpt-4o        # RULER relative-scoring judge
# REWARD_CORRECT_WEIGHT=0.70       # strict answer correctness
# REWARD_SOURCE_WEIGHT=0.20        # reference-message citation F1
# REWARD_RULER_WEIGHT=0.10         # relative answer quality
# VAL_LIMIT=30                     # fixed held-out comparison set
# VAL_INTERVAL=5
# EARLY_STOP_PATIENCE=2
# MAX_STEPS=20
# BASELINE_ACCURACY=0.7333333333333333  # 22/30 gpt-4.1-mini
# UNTRAINED_ACCURACY=0.6                # 18/30 Qwen3-14B
